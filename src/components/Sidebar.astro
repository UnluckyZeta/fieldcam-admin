
---

const adminRole =
  Astro.cookies
    .get("admin_role")
    ?.value;
    console.log(adminRole)
  ---

<nav class="sidebar">
  <div class="sidebar-links">
    <a href="/">Dashboard</a>
    <a href="/engineers">Engineers</a>
    <a href="/offline-engineers">Offline Engineers</a>
    <a href="/verify">Verify</a>
    {
      adminRole === "super_admin" && (
        <a href="/admins">
          Admins
        </a>
      )
    }
  </div>

  <div class="sidebar-footer">
    <!-- Theme Toggle Button -->
    <button
      id="theme-toggle-btn-sidebar"
      class="theme-toggle-btn"
      type="button"
    >
      <svg id="theme-icon-sidebar" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
      <span>Toggle Theme</span>
    </button>

    <button
      onclick="logout()"
      class="logout-btn"
    >
      Logout
    </button>
  </div>
</nav>

<style>
  .sidebar {
    width: 220px;
    height: 100vh;
    position: sticky;
    top: 0;
    background: white;
    border-right: 1px solid #ddd;
    box-sizing: border-box;

    display: flex;
    flex-direction: column;
    padding: 20px 20px 16px 20px;
  }

  .sidebar-links {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    overflow-y: auto;
    /* Hide scrollbar */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .sidebar-links::-webkit-scrollbar {
    display: none;
  }

  .sidebar a {
    text-decoration: none;
    color: black;
    padding: 8px 12px;
    border-radius: 6px;
    transition: background 0.2s;
  }

  .sidebar a:hover {
    background: #f3f4f6;
  }

  .sidebar-footer {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 1px solid #eee;
    padding-top: 16px;
    margin-top: 12px;
  }

  .theme-toggle-btn {
    width: 100%;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 6px;
    background: #f3f4f6;
    color: #374151;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
    transition: background 0.2s, color 0.2s;
  }

  .logout-btn {
    width: 100%;
    padding: 10px;
    border: none;
    border-radius: 6px;
    background: #dc2626;
    color: white;
    cursor: pointer;
  }

  .logout-btn:hover {
    background: #b91c1c;
  }

  @media (max-width: 767px) {
    .sidebar {
      position: fixed;
      top: 0;
      left: -260px; /* Hidden offscreen */
      width: 220px;
      height: 100vh;
      box-shadow: 4px 0 16px rgba(0, 0, 0, 0.15);
      z-index: 1000;
      transition: left 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    :global(.menu-open) .sidebar {
      left: 0;
    }
  }
</style>
<script type="module">
  import "../../src/scripts/auth";
</script>