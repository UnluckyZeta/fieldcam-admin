---
import Sidebar from "../components/Sidebar.astro";
import { ClientRouter } from "astro:transitions";

const {
  title = "FieldCam Admin",
} = Astro.props;

const isLoginPage =
  Astro.url.pathname ===
  "/login";

const adminId =
  Astro.cookies
    .get("admin_id")
    ?.value;

if (!isLoginPage && !adminId) {
  return Astro.redirect("/login");
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{title}</title>
    <ClientRouter />
  </head>

  <body>
    <div id="nav-progress-bar" class="nav-progress-bar"></div>
    {
      isLoginPage ? (
        <main class="login-main">
          <slot />
        </main>
      ) : (
        <div class="app">
          <Sidebar />

          <main>
            <slot />
          </main>
        </div>
      )
    }
  </body>
</html>

<script>
  document.addEventListener("astro:before-preparation", () => {
    const bar = document.getElementById("nav-progress-bar");
    if (bar) {
      bar.style.width = "40%";
      bar.style.opacity = "1";
    }
  });

  document.addEventListener("astro:after-preparation", () => {
    const bar = document.getElementById("nav-progress-bar");
    if (bar) {
      bar.style.width = "80%";
    }
  });

  document.addEventListener("astro:page-load", () => {
    const bar = document.getElementById("nav-progress-bar");
    if (bar) {
      bar.style.width = "100%";
      setTimeout(() => {
        bar.style.opacity = "0";
        bar.style.width = "0%";
      }, 200);
    }
  });
</script>

<style>
  body {
    margin: 0;
    font-family:
      Arial,
      sans-serif;
    background: #f5f5f5;
  }

  .nav-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    background: #2563eb;
    width: 0%;
    opacity: 0;
    transition: width 0.2s ease, opacity 0.2s ease;
    z-index: 9999;
    pointer-events: none;
  }

  .app {
    display: flex;
    min-height: 100vh;
  }

  main {
    flex: 1;
    padding: 24px;
  }

  .login-main {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
  }
</style>