---
import AdminLayout from "../layouts/AdminLayout.astro";
---

<AdminLayout title="Risk Center | FieldCam Admin">
  <div class="page-header">
    <h1>🚨 Risk Center</h1>
    <p class="subtitle">Real-time anomaly detection for GPS spoofing, impossible location jumps, and clock tampering.</p>
  </div>

  <!-- Summary Statistics -->
  <div class="stats-grid">
    <div class="stat-card stat-danger">
      <div class="stat-icon-wrap danger-bg">⚠️</div>
      <div class="stat-body">
        <div class="stat-value" id="stat-total-risk">—</div>
        <div class="stat-label">Flagged Engineers</div>
      </div>
    </div>
    <div class="stat-card stat-warn">
      <div class="stat-icon-wrap warn-bg">📍</div>
      <div class="stat-body">
        <div class="stat-value" id="stat-gps-risk">—</div>
        <div class="stat-label">GPS / Location Risks</div>
      </div>
    </div>
    <div class="stat-card stat-purple">
      <div class="stat-icon-wrap purple-bg">🕒</div>
      <div class="stat-body">
        <div class="stat-value" id="stat-time-risk">—</div>
        <div class="stat-label">Clock / Time Risks</div>
      </div>
    </div>
    <div class="stat-card stat-blue">
      <div class="stat-icon-wrap blue-bg">👁️</div>
      <div class="stat-body">
        <div class="stat-value" id="stat-tracked">—</div>
        <div class="stat-label">Tracked / Watchlist</div>
      </div>
    </div>
  </div>

  <!-- Toolbar -->
  <div class="toolbar-flat">
    <form id="risk-filter-form" class="filters">
      <input type="date" id="input-from" name="from" onfocus="this.showPicker()" />
      <input type="date" id="input-to" name="to" onfocus="this.showPicker()" />
      <button type="submit">Apply</button>
      <a href="/risk-center" class="btn-reset">Reset</a>
      <input id="search" type="text" class="search-input" placeholder="Search engineer name, code..." />
      <select id="risk-type-filter" class="filter-select">
        <option value="">All Risk Types</option>
        <option value="gps">📍 GPS / Location Only</option>
        <option value="time">🕒 Clock / Time Only</option>
        <option value="tracked">👁️ Tracked Only</option>
      </select>
    </form>
  </div>

  <!-- Track Engineer By Name -->
  <div class="track-search-panel">
    <div class="track-search-row">
      <input id="track-name-search" type="text" class="search-input" placeholder="🔍 Search any engineer by name, code, or email to track..." />
      <button id="track-search-btn" type="button">Search</button>
    </div>
    <div id="track-search-results"></div>
  </div>

  <!-- Flag Photo By Tag -->
  <div class="track-search-panel">
    <div class="track-search-row">
      <input id="photo-tag-search" type="text" class="search-input" placeholder="🚩 Enter any photo tag (e.g. FC-XXXXXXXX) to inspect and flag/clear..." />
      <button id="photo-search-btn" type="button" style="background:#ef4444;">Search Photo</button>
    </div>
    <div id="photo-search-results"></div>
  </div>

  <!-- Risk Cards Container (rendered by JS) -->
  <div id="risk-cards-container">
    <div class="loading-placeholder">
      <div class="skeleton" style="height:80px;border-radius:10px;"></div>
      <div class="skeleton" style="height:80px;border-radius:10px;"></div>
    </div>
  </div>
</AdminLayout>

<style>
  .page-header { margin-bottom: 24px; }
  .page-header h1 { margin: 0 0 6px 0; font-size: 22px; font-weight: 700; }
  .subtitle { margin: 0; color: #64748b; font-size: 13px; }

  /* ── Stat Cards ── */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
    margin-bottom: 20px;
  }
  .stat-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    background: white;
    border-radius: 10px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  }
  .stat-icon-wrap {
    width: 42px; height: 42px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; flex-shrink: 0;
  }
  .danger-bg { background: #fee2e2; }
  .warn-bg   { background: #fef3c7; }
  .purple-bg { background: #f3e8ff; }
  .blue-bg   { background: #dbeafe; }
  .stat-value { font-size: 22px; font-weight: 700; line-height: 1.2; }
  .stat-label { font-size: 12px; color: #64748b; }

  /* ── Toolbar ── */
  .toolbar-flat { margin-bottom: 20px; }
  .filters {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
  }
  .filters input[type="date"], .filter-select, .search-input {
    height: 36px; padding: 0 10px;
    border: 1px solid #d1d5db; border-radius: 6px;
    font-size: 13px; background: white;
  }
  .search-input { flex: 1; min-width: 200px; }
  .filter-select { min-width: 160px; }
  .filters button, .btn-reset {
    height: 36px; padding: 0 14px; border-radius: 6px;
    font-size: 13px; font-weight: 500; cursor: pointer;
    text-decoration: none; display: inline-flex;
    align-items: center; justify-content: center;
  }
  .filters button { background: #2563eb; color: white; border: 1px solid transparent; }
  .btn-reset { background: #6b7280; color: white; }

  /* ── Track Search Panel ── */
  .track-search-panel {
    margin-bottom: 18px;
    background: white;
    border-radius: 10px;
    padding: 14px 18px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  }
  .track-search-row {
    display: flex; gap: 10px; align-items: center;
  }
  .track-search-row .search-input { flex: 1; }
  .track-search-row button {
    height: 36px; padding: 0 16px; border-radius: 6px;
    background: #6366f1; color: white; border: none;
    font-size: 13px; font-weight: 500; cursor: pointer;
  }
  :global(#track-search-results) {
    margin-top: 10px;
  }
  :global(.tsr-item) {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 12px; border-radius: 8px;
    border: 1px solid #e2e8f0; margin-bottom: 6px;
    gap: 12px;
  }
  :global(.tsr-item:hover) { background: #f8fafc; }
  :global(.tsr-info) { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0; }
  :global(.tsr-avatar) {
    width: 34px; height: 34px; border-radius: 8px;
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: white; display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 13px; flex-shrink: 0;
  }
  :global(.tsr-name) { font-weight: 600; font-size: 13px; }
  :global(.tsr-meta) { font-size: 11px; color: #64748b; }
  :global(.tsr-actions) { display: flex; gap: 6px; flex-shrink: 0; }
  :global(.tsr-already) {
    font-size: 11px; color: #10b981; font-weight: 600;
    display: flex; align-items: center; gap: 4px;
  }

  /* ── Risk Engineer Cards ── */
  :global(.risk-card) {
    background: white;
    border-radius: 10px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    margin-bottom: 14px;
    overflow: hidden;
    border: 2px solid transparent;
    transition: border-color 0.2s;
  }
  :global(.risk-card-tracked) {
    border-color: #3b82f6;
    box-shadow: 0 0 0 1px rgba(59,130,246,0.15), 0 2px 8px rgba(59,130,246,0.1);
  }
  :global(.risk-card-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    gap: 12px;
    cursor: pointer;
    user-select: none;
  }
  :global(.risk-card-header:hover) {
    background: rgba(0,0,0,0.02);
  }
  :global(.rc-left) {
    display: flex; align-items: center; gap: 12px; flex: 1; min-width: 0;
  }
  :global(.rc-avatar) {
    width: 38px; height: 38px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 15px; flex-shrink: 0;
    color: white;
  }
  :global(.rc-avatar-danger) { background: linear-gradient(135deg, #ef4444, #dc2626); }
  :global(.rc-avatar-warn) { background: linear-gradient(135deg, #f59e0b, #d97706); }
  :global(.rc-info) { min-width: 0; }
  :global(.rc-name) { font-weight: 600; font-size: 14px; color: #1e293b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  :global(.rc-meta) { font-size: 12px; color: #64748b; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  :global(.rc-meta span) { white-space: nowrap; }
  :global(.rc-tracked-reason) {
    font-size: 11px; color: #3b82f6; margin-top: 2px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    max-width: 240px;
  }
  :global(.rc-badges) { display: flex; gap: 6px; flex-wrap: wrap; }
  :global(.rc-badge) {
    padding: 3px 8px; border-radius: 9999px;
    font-size: 11px; font-weight: 600; white-space: nowrap;
  }
  :global(.rc-badge-gps)  { background: #fef3c7; color: #92400e; }
  :global(.rc-badge-time) { background: #f3e8ff; color: #6b21a8; }
  :global(.rc-badge-tracked) { background: #dbeafe; color: #1d4ed8; }
  :global(.rc-right) {
    display: flex; align-items: center; gap: 8px; flex-shrink: 0;
  }
  :global(.rc-date) { font-size: 12px; color: #64748b; white-space: nowrap; }
  :global(.rc-toggle) { font-size: 10px; color: #94a3b8; transition: transform 0.2s; }
  :global(.rc-toggle.open) { transform: rotate(180deg); }
  :global(.rc-btn) {
    padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 500;
    white-space: nowrap; cursor: pointer; border: none;
    text-decoration: none; display: inline-flex; align-items: center;
  }
  :global(.rc-btn-logs) {
    background: #2563eb; color: white !important;
  }
  :global(.rc-btn-track) {
    background: #dbeafe; color: #1d4ed8;
    border: 1px solid #93c5fd;
  }
  :global(.rc-btn-track:hover) {
    background: #bfdbfe;
  }
  :global(.rc-btn-untrack) {
    background: #fee2e2; color: #991b1b;
    border: 1px solid #fca5a5;
  }
  :global(.rc-btn-untrack:hover) {
    background: #fecaca;
  }

  /* ── Evidence Panel ── */
  :global(.rc-evidence-panel) {
    max-height: 0; overflow: hidden;
    transition: max-height 0.3s ease;
    border-top: 1px solid transparent;
  }
  :global(.rc-evidence-panel.open) {
    max-height: 2000px;
    border-top-color: #f1f5f9;
  }
  :global(.rc-evidence-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 10px;
    padding: 14px 18px;
  }
  :global(.ev-card) {
    padding: 12px 14px;
    border-radius: 8px;
    font-size: 13px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 6px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
    overflow: hidden;
    min-width: 0;
  }
  :global(.ev-card-gps) {
    background: #fff5f5; color: #991b1b; border-left: 4px solid #f87171; border-color: #fca5a5;
  }
  :global(.ev-card-time) {
    background: #fffbeb; color: #92400e; border-left: 4px solid #fbbf24; border-color: #fcd34d;
  }
  :global(.ev-card-top) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-bottom: 2px;
  }
  :global(.ev-title) { font-weight: 700; font-size: 13px; display: flex; align-items: center; flex-wrap: wrap; min-width: 0; }
  :global(.ev-actions) {
    display: flex;
    gap: 4px;
    flex-shrink: 0;
  }
  :global(.ev-action-btn) {
    padding: 3px 8px;
    font-size: 11px;
    border-radius: 4px;
    cursor: pointer;
    font-weight: 600;
    border: none;
    line-height: 1.1;
    display: inline-flex;
    align-items: center;
    transition: background 0.15s, transform 0.1s;
  }
  :global(.ev-action-btn:active) {
    transform: scale(0.95);
  }
  :global(.ev-btn-clear) {
    background: #10b981;
    color: white !important;
  }
  :global(.ev-btn-clear:hover) {
    background: #059669;
  }
  :global(.ev-btn-flag) {
    background: #ef4444;
    color: white !important;
  }
  :global(.ev-btn-flag:hover) {
    background: #dc2626;
  }
  :global(.rc-badge-clear) {
    background: #10b981;
    color: white;
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: bold;
    margin-left: 6px;
  }
  :global(.rc-badge-manual-flag) {
    background: #ef4444;
    color: white;
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: bold;
    margin-left: 6px;
  }
  :global(.rc-badge-pending-clear) {
    background: #f59e0b;
    color: white;
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: bold;
    margin-left: 6px;
  }
  :global(.ev-btn-approve) {
    background: #3b82f6;
    color: white !important;
  }
  :global(.ev-btn-approve:hover) {
    background: #2563eb;
  }
  :global(.ev-btn-reject) {
    background: #6b7280;
    color: white !important;
  }
  :global(.ev-btn-reject:hover) {
    background: #4b5563;
  }
  :global(.ev-tag-link) {
    background: rgba(0, 0, 0, 0.05);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 600;
    color: #2563eb !important;
    text-decoration: underline !important;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.15s;
  }
  :global(.ev-tag-link:hover) {
    color: #1d4ed8 !important;
  }
  :global(.ev-detail) { font-size: 12px; line-height: 1.5; color: #475569; word-break: break-word; overflow-wrap: break-word; }
  :global(.ev-footer) {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 4px;
    font-size: 11px;
    opacity: 0.85;
    gap: 8px;
  }
  :global(.ev-footer-right) {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    flex-wrap: wrap;
  }

  /* ── Loading & Empty ── */
  .loading-placeholder { display: flex; flex-direction: column; gap: 14px; }
  .skeleton {
    background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
  }
  @keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

  :global(.empty-state) {
    text-align: center; padding: 48px 24px; color: #94a3b8; font-size: 15px;
  }

  /* ═══ Dark Theme ═══ */
  :global(.dark-theme) .stat-card,
  :global(.dark-theme .risk-card),
  :global(.dark-theme) .track-search-panel {
    background-color: var(--bg-secondary) !important;
    color: var(--text-primary) !important;
  }
  :global(.dark-theme .tsr-item) { border-color: var(--border-color); }
  :global(.dark-theme .tsr-item:hover) { background: rgba(255,255,255,0.03); }
  :global(.dark-theme .tsr-name) { color: #f1f5f9; }
  :global(.dark-theme .tsr-meta) { color: #94a3b8; }
  :global(.dark-theme .risk-card-tracked) {
    border-color: #3b82f6;
    box-shadow: 0 0 0 1px rgba(59,130,246,0.25), 0 2px 8px rgba(59,130,246,0.15);
  }
  :global(.dark-theme) .danger-bg { background: rgba(239,68,68,0.2); }
  :global(.dark-theme) .warn-bg   { background: rgba(245,158,11,0.2); }
  :global(.dark-theme) .purple-bg { background: rgba(139,92,246,0.2); }
  :global(.dark-theme) .blue-bg   { background: rgba(59,130,246,0.2); }
  :global(.dark-theme .rc-name)   { color: #f1f5f9; }
  :global(.dark-theme .rc-meta),
  :global(.dark-theme .rc-date),
  :global(.dark-theme) .stat-label,
  :global(.dark-theme) .subtitle  { color: #94a3b8; }
  :global(.dark-theme .rc-tracked-reason) { color: #60a5fa; }
  :global(.dark-theme .risk-card-header:hover) { background: rgba(255,255,255,0.03); }
  :global(.dark-theme .rc-evidence-panel.open) { border-top-color: var(--border-color); }
  :global(.dark-theme .ev-card) { border-color: var(--border-color) !important; }
  :global(.dark-theme .ev-card-gps)  { background: rgba(239, 68, 68, 0.1) !important; color: #fca5a5 !important; border-left: 4px solid #ef4444 !important; }
  :global(.dark-theme .ev-card-time) { background: rgba(245, 158, 11, 0.1) !important; color: #fcd34d !important; border-left: 4px solid #f59e0b !important; }
  :global(.dark-theme .ev-detail) { color: #cbd5e1 !important; }
  :global(.dark-theme .ev-tag-link) { background: rgba(255, 255, 255, 0.1) !important; color: #60a5fa !important; }
  :global(.dark-theme .ev-tag-link:hover) { color: #93c5fd !important; }
  :global(.dark-theme .rc-badge-gps)  { background: rgba(245, 158, 11, 0.2); color: #fcd34d; }
  :global(.dark-theme .rc-badge-time) { background: rgba(139, 92, 246, 0.2); color: #c4b5fd; }
  :global(.dark-theme .rc-badge-tracked) { background: rgba(59, 130, 246, 0.2); color: #93c5fd; }
  :global(.dark-theme .rc-btn-track) {
    background: rgba(59, 130, 246, 0.15); color: #93c5fd; border-color: rgba(59, 130, 246, 0.3);
  }
  :global(.dark-theme .rc-btn-untrack) {
    background: rgba(239, 68, 68, 0.15); color: #fca5a5; border-color: rgba(239, 68, 68, 0.3);
  }
  :global(.dark-theme) .filters input[type="date"],
  :global(.dark-theme) .filter-select,
  :global(.dark-theme) .search-input {
    background: var(--bg-secondary); color: var(--text-primary);
    border-color: var(--border-color);
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .filters { flex-direction: column; align-items: stretch; }
    .filters input, .filters select, .filters button, .filters a {
      width: 100% !important; min-width: 0 !important; box-sizing: border-box;
    }
    :global(.risk-card-header) { flex-wrap: wrap; }
    :global(.rc-right) { width: 100%; justify-content: space-between; margin-top: 8px; }
    :global(.rc-evidence-grid) { grid-template-columns: 1fr; }
  }
</style>

<script type="module">
  import "../scripts/risk-center";
</script>
</AdminLayout>
