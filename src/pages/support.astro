<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FieldCam Support</title>
    <style>
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background: #0f172a;
        color: #f8fafc;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 20px;
      }
      .card {
        background: #1e293b;
        border-radius: 16px;
        padding: 36px;
        max-width: 500px;
        width: 100%;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        border: 1px solid #334155;
        text-align: center;
      }
      h1 {
        margin-top: 0;
        font-size: 28px;
        color: #38bdf8;
      }
      p {
        color: #94a3b8;
        font-size: 15px;
        line-height: 1.6;
      }
      .contact-group {
        margin-top: 24px;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 14px 20px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 15px;
        text-decoration: none;
        transition: opacity 0.2s;
      }
      .btn-whatsapp {
        background: #22c55e;
        color: white;
      }
      .btn-email {
        background: #0284c7;
        color: white;
      }
      .btn-phone {
        background: #475569;
        color: white;
      }
      .btn:hover {
        opacity: 0.9;
      }
      .footer {
        margin-top: 28px;
        font-size: 12px;
        color: #64748b;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>FieldCam Support</h1>
      <p>
        Welcome to FieldCam Support. If you have any questions, need technical assistance, or need help with photo verification, please contact our dedicated support team:
      </p>

      <div class="contact-group">
        <a href="https://wa.me/201002337985" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp">
          💬 WhatsApp Support (+20 100 233 7985)
        </a>
        <a href="mailto:support@hayakarema.com" class="btn btn-email">
          ✉️ Email Support (support@hayakarema.com)
        </a>
        <a href="tel:+201002337985" class="btn btn-phone">
          📞 Call Support (+20 100 233 7985)
        </a>
      </div>

      <div class="footer">
        © 2026 FieldCam. All rights reserved.
      </div>
    </div>
  </body>
</html>
