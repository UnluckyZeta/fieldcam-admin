---
import AdminLayout from "../layouts/AdminLayout.astro";
---

<AdminLayout title="Offline Engineers">
  <div class="page-header">
    <h1>🔴 Offline Engineers (<span id="title-offline-count">...</span>)</h1>
    <p class="subtitle">
      Showing engineers who captured <strong>0 photos</strong> between <span id="text-from">...</span> and <span id="text-to">...</span>.
    </p>
  </div>

  <div class="toolbar">
    <form method="GET" class="filters">
      <input
        type="date"
        id="input-from"
        name="from"
        onfocus="this.showPicker()"
      />

      <input
        type="date"
        id="input-to"
        name="to"
        onfocus="this.showPicker()"
      />

      <button type="submit">Apply Filter</button>

      <a href="/offline-engineers" class="btn-reset">Reset</a>

      <input
        id="search"
        type="text"
        class="search-input"
        placeholder="Search by name, code or email..."
      />

      <button
        id="export-offline-btn"
        type="button"
        class="btn-export-offline"
      >
        Export Offline CSV
      </button>
    </form>
  </div>

  <div class="stats">
    <div class="stat-card">
      <h3>Offline Engineers</h3>
      <p id="stat-offline" class="stat-val skeleton-text skeleton"></p>
    </div>

    <div class="stat-card">
      <h3>Total Engineers</h3>
      <p id="stat-total" class="stat-val skeleton-text skeleton"></p>
    </div>

    <div class="stat-card">
      <h3>Active Engineers in Range</h3>
      <p id="stat-active" class="stat-val skeleton-text skeleton"></p>
    </div>
  </div>

  <div class="section" id="table-container">
    <table id="offline-table" class="offline-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Code</th>
          <th>Email</th>
          <th>Governorate / Region</th>
          <th>Subregion</th>
          <th>Last Active</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody id="offline-tbody">
        <tr class="skeleton-row">
          <td><div class="skeleton" style="height: 20px; width: 140px;"></div></td>
          <td><div class="skeleton" style="height: 20px; width: 80px;"></div></td>
          <td><div class="skeleton" style="height: 20px; width: 160px;"></div></td>
          <td><div class="skeleton" style="height: 20px; width: 100px;"></div></td>
          <td><div class="skeleton" style="height: 20px; width: 100px;"></div></td>
          <td><div class="skeleton" style="height: 20px; width: 140px;"></div></td>
          <td><div class="skeleton" style="height: 20px; width: 80px;"></div></td>
        </tr>
        <tr class="skeleton-row">
          <td><div class="skeleton" style="height: 20px; width: 140px;"></div></td>
          <td><div class="skeleton" style="height: 20px; width: 80px;"></div></td>
          <td><div class="skeleton" style="height: 20px; width: 160px;"></div></td>
          <td><div class="skeleton" style="height: 20px; width: 100px;"></div></td>
          <td><div class="skeleton" style="height: 20px; width: 100px;"></div></td>
          <td><div class="skeleton" style="height: 20px; width: 140px;"></div></td>
          <td><div class="skeleton" style="height: 20px; width: 80px;"></div></td>
        </tr>
      </tbody>
    </table>
  </div>
</AdminLayout>

<style is:global>
  /* Shimmering Skeleton Animations */
  .skeleton {
    background: linear-gradient(90deg, #f3f4f6 25%, #e5e7eb 50%, #f3f4f6 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite linear;
    border-radius: 6px;
  }

  .skeleton-text {
    height: 28px;
    width: 90px;
    margin-top: 8px;
  }

  @keyframes shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  .page-header {
    margin-bottom: 24px;
  }

  .page-header h1 {
    margin: 0 0 6px 0;
    font-size: 24px;
    color: #111827;
  }

  .subtitle {
    margin: 0;
    font-size: 14px;
    color: #6b7280;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }

  .stat-card {
    background: white;
    border-radius: 8px;
    padding: 16px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .stat-card h3 {
    margin: 0;
    font-size: 14px;
    color: #666;
  }

  .stat-card p {
    margin-top: 8px;
    margin-bottom: 0;
    font-size: 28px;
    font-weight: 700;
  }

  .toolbar {
    margin-bottom: 24px;
  }

  .filters {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .filters input[type="date"] {
    padding: 10px 12px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    background: white;
    cursor: pointer;
    min-width: 160px;
  }

  .search-input {
    padding: 10px 12px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    flex: 1;
    min-width: 220px;
  }

  .filters button,
  .btn-reset {
    height: 40px;
    padding: 0 16px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 500;
  }

  .filters button[type="submit"] {
    background: #2563eb;
    color: white;
  }

  .filters button[type="submit"]:hover {
    background: #1d4ed8;
  }

  .btn-reset {
    background: #6b7280;
    color: white;
  }

  .btn-reset:hover {
    background: #4b5563;
  }

  .btn-export-offline {
    background: #f59e0b;
    color: white;
  }

  .btn-export-offline:hover {
    background: #d97706;
  }

  .section {
    background: white;
    border-radius: 8px;
    padding: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .offline-table {
    width: 100%;
    border-collapse: collapse;
  }

  .offline-table th,
  .offline-table td {
    padding: 12px;
    border: 1px solid #e5e7eb;
    text-align: left;
  }

  .offline-table th {
    background: #f8fafc;
    font-weight: 600;
  }

  .btn-view {
    display: inline-block;
    padding: 6px 12px;
    background: #2563eb;
    color: white;
    text-decoration: none;
    border-radius: 6px;
    font-size: 13px;
  }

  .btn-view:hover {
    background: #1d4ed8;
  }

  .danger {
    color: #dc2626;
  }

  .success {
    color: #16a34a;
  }

  .all-active-msg {
    font-size: 18px;
    color: #16a34a;
    font-weight: 600;
    padding: 40px 0;
    text-align: center;
  }

  .sortable {
    cursor: pointer;
    user-select: none;
  }

  .sortable:hover {
    background: #eff6ff;
  }
</style>

<script>
  import { getOfflineStats } from "../lib/api";
  import { requireAdmin } from "../lib/auth";
  import { makeTableSortable } from "../scripts/table-sort";

  requireAdmin();

  function formatEgyptDate(dateStr) {
    if (!dateStr) return "Never";
    return new Date(dateStr)
      .toLocaleString("en-US", {
        timeZone: "Africa/Cairo",
        day: "2-digit",
        month: "short",
        year: "numeric",
        hour: "numeric",
        minute: "2-digit",
        hour12: true,
      })
      .replace(",", " •");
  }

  document.addEventListener("astro:page-load", async () => {
    const today = new Date().toLocaleDateString("en-CA", {
      timeZone: "Africa/Cairo",
    });

    const params = new URLSearchParams(window.location.search);
    const from = params.get("from") || today;
    const to = params.get("to") || today;

    const textFrom = document.getElementById("text-from");
    const textTo = document.getElementById("text-to");
    if (textFrom) textFrom.textContent = from;
    if (textTo) textTo.textContent = to;

    const fromInput = document.getElementById("input-from") as HTMLInputElement;
    const toInput = document.getElementById("input-to") as HTMLInputElement;
    if (fromInput) fromInput.value = from;
    if (toInput) toInput.value = to;

    const adminId = document.cookie
      .split("; ")
      .find((row) => row.startsWith("admin_id="))
      ?.split("=")[1] || "";

    try {
      // Fetch stats using our new optimized single RPC endpoint
      const data = await getOfflineStats(from, to, adminId);
      const offlineEngineers = data.offline_engineers ?? [];
      const totalCount = data.total_engineers ?? 0;
      const activeCount = data.active_count ?? 0;

      // Render count in header title
      const titleCountEl = document.getElementById("title-offline-count");
      if (titleCountEl) titleCountEl.textContent = String(offlineEngineers.length);

      const statOfflineEl = document.getElementById("stat-offline");
      const statTotalEl = document.getElementById("stat-total");
      const statActiveEl = document.getElementById("stat-active");

      if (statOfflineEl) {
        statOfflineEl.textContent = String(offlineEngineers.length);
        statOfflineEl.className = "stat-val " + (offlineEngineers.length > 0 ? "danger" : "success");
        statOfflineEl.classList.remove("skeleton", "skeleton-text");
      }
      if (statTotalEl) {
        statTotalEl.textContent = String(totalCount);
        statTotalEl.classList.remove("skeleton", "skeleton-text");
      }
      if (statActiveEl) {
        statActiveEl.textContent = String(activeCount);
        statActiveEl.classList.remove("skeleton", "skeleton-text");
      }

      // Render table layout dynamically
      const container = document.getElementById("table-container");
      if (container) {
        if (offlineEngineers.length === 0) {
          container.innerHTML = `
            <div class="empty-state">
              <p class="all-active-msg">🎉 All engineers were active during this period!</p>
            </div>
          `;
        } else {
          container.innerHTML = `
            <table id="offline-table" class="offline-table">
              <thead>
                <tr>
                  <th class="sortable">Name</th>
                  <th class="sortable">Code</th>
                  <th class="sortable">Email</th>
                  <th class="sortable">Governorate / Region</th>
                  <th class="sortable">Subregion</th>
                  <th class="sortable">Last Active</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody id="offline-tbody">
                ${offlineEngineers.map((engineer: any) => {
                  const region = engineer.region || engineer.auto_region || "-";
                  const subregion = engineer.subregion || engineer.auto_subregion || "-";
                  const lastActive = engineer.last_photo_at ? formatEgyptDate(engineer.last_photo_at) : "Never";
                  return `
                    <tr>
                      <td><strong>${engineer.full_name || "Unnamed"}</strong></td>
                      <td><code>${engineer.engineer_code || "-"}</code></td>
                      <td>${engineer.email || "-"}</td>
                      <td>${region}</td>
                      <td>${subregion}</td>
                      <td>${lastActive}</td>
                      <td>
                        <a class="btn-view" href="/engineers/${engineer.id}">
                          View Profile
                        </a>
                      </td>
                    </tr>
                  `;
                }).join("")}
              </tbody>
            </table>
          `;
          
          makeTableSortable("offline-table");
        }
      }

      // Bind search filtering
      document.getElementById("search")?.addEventListener("input", (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
        const rows = document.querySelectorAll("#offline-table tbody tr");
        rows.forEach((row) => {
          const text = row.textContent?.toLowerCase() ?? "";
          (row as HTMLElement).style.display = text.includes(query) ? "" : "none";
        });
      });

      // Bind export button with UTF-8 BOM representation, cloning to strip duplicate listeners
      const exportOfflineBtn = document.getElementById("export-offline-btn");
      if (exportOfflineBtn) {
        const newBtn = exportOfflineBtn.cloneNode(true) as HTMLButtonElement;
        exportOfflineBtn.replaceWith(newBtn);
        newBtn.addEventListener("click", () => {
          newBtn.disabled = true;
          newBtn.textContent = "⏳ Exporting CSV...";
          newBtn.style.opacity = "0.7";
          newBtn.style.cursor = "wait";

          try {
            const table = document.getElementById("offline-table");
            if (!table || offlineEngineers.length === 0) {
              alert("No offline engineers to export.");
              return;
            }

            const headers = ["Name", "Code", "Email", "Region", "Subregion", "Last Active"];
            const csvRows = [headers.join(",")];

            offlineEngineers.forEach((engineer: any) => {
              const region = engineer.region || engineer.auto_region || "-";
              const subregion = engineer.subregion || engineer.auto_subregion || "-";
              const lastActive = engineer.last_photo_at ? formatEgyptDate(engineer.last_photo_at) : "Never";
              
              csvRows.push([
                `"${(engineer.full_name ?? "").replace(/"/g, '""')}"`,
                `"${(engineer.engineer_code ?? "").replace(/"/g, '""')}"`,
                `"${(engineer.email ?? "").replace(/"/g, '""')}"`,
                `"${region.replace(/"/g, '""')}"`,
                `"${subregion.replace(/"/g, '""')}"`,
                `"${lastActive.replace(/"/g, '""')}"`,
              ].join(","));
            });

            // UTF-8 BOM helps Excel recognize Arabic characters correctly
            const csv = "\uFEFF" + csvRows.join("\r\n");
            const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = `fieldcam-offline-engineers-${from}-to-${to}.csv`;
            a.click();
            URL.revokeObjectURL(url);
          } finally {
            setTimeout(() => {
              newBtn.disabled = false;
              newBtn.textContent = "Export Offline CSV";
              newBtn.style.opacity = "1";
              newBtn.style.cursor = "pointer";
            }, 500);
          }
        });
      }

    } catch (e) {
      console.error("Failed to load offline statistics:", e);
      const container = document.getElementById("table-container");
      if (container) {
        container.innerHTML = `
          <div style="text-align: center; color: red; padding: 40px 0;">
            Failed to load offline statistics.
          </div>
        `;
      }
    }
  });
</script>
