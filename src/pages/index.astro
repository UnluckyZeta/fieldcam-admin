      );
    gap: 16px;
    margin-bottom: 32px;
  }
.filters {
  display: flex;
  gap: 12px;
  margin-bottom: 24px;
}

.filters input {
  padding: 10px;
}

.filters button {
  padding: 10px 16px;
  cursor: pointer;
}
  .stat-card {
    background: white;
    border-radius: 8px;
    padding: 16px;
    box-shadow:
      0 2px 8px
      rgba(
        0,
        0,
        0,
        0.05
      );
  }

  .stat-card h3 {
    margin: 0;
    font-size: 14px;
    color: #666;
  }
.filters {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

.filters input[type="date"] {
  padding: 10px 12px;
  border: 1px solid #d1d5db;
  border-radius: 6px;
  background: white;
  cursor: pointer;
  min-width: 160px;
}

.filters button,
.btn-reset {
  height: 40px;
  padding: 0 16px;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
