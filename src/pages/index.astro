  table {
    width: 100%;
    border-collapse: collapse;
  }

  th,
  td {
    padding: 12px;
    border: 1px solid #e5e7eb;
    text-align: left;
  }

  th {
    background: #f8fafc;
  }

  .btn {
    display: inline-block;
    padding: 6px 12px;
    background: #2563eb;
    color: white;
    text-decoration: none;
    border-radius: 6px;
  }

  .danger {
    color: #dc2626;
  }

  .success {
    color: #16a34a;
  }input[  type="date"
      onfocus="this.showPicker()"] {
  cursor: pointer;
}
.dashboard-grid{
  display:grid;
  gap:24px;
  margin-top:24px;
}

@media(max-width:1000px){

.dashboard-grid{
}

}
.sortable {
  cursor: pointer;
  user-select: none;
  transition: background .2s;
}

.sortable:hover {
  background: #eff6ff;
}

.sort-asc::after {
  content: " ▲";
  color: #2563eb;
}

.sort-desc::after {
  content: " ▼";
  color: #2563eb;
}

.section-offline h2 {
  display: flex;
  align-items: center;
  gap: 8px;
}

.offline-count {
  font-size: 16px;
