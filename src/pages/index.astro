  justify-content: center;
  padding: 10px 16px;
  background: #6b7280;
  color: white;
  text-decoration: none;
  border-radius: 6px;
}
  .stat-card p {
    margin-top: 8px;
    font-size: 28px;
    font-weight: 700;
  }

  .section {
    background: white;
    border-radius: 8px;
    padding: 20px;
