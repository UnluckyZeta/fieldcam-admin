---
import AdminLayout from "../layouts/AdminLayout.astro";
import { getDashboard, getEngineers } from "../lib/api";

function formatEgyptDate(
  date: string,
) {
  return new Date(date)
    .toLocaleString(
      "en-US",
      {
        timeZone:
          "Africa/Cairo",
        day: "2-digit",
        month: "short",
        year: "numeric",
        hour: "numeric",
        minute: "2-digit",
        hour12: true,
      },
    )
    .replace(",", " •");
}
const today =
  new Date()
    .toISOString()
    .split("T")[0];

const from =
  Astro.url.searchParams.get(
    "from",
  ) ?? today;

const to =
  Astro.url.searchParams.get(
    "to",
  ) ?? today;

const adminId =
  Astro.cookies
    .get("admin_id")
    ?.value ?? "";
    

const [data, engineersData] = await Promise.all([
  getDashboard(from, to, adminId),
  getEngineers("", "", adminId),
]);

const profilesMap = new Map(
  (engineersData.engineers ?? []).map((e: any) => [e.id, e])
);

// Compute offline engineers: those with NO activity in the selected date range
const activeIds = new Set(
  (data.engineers_today ?? []).map((e: any) => e.id)
);
const offlineEngineers = (engineersData.engineers ?? []).filter(
  (e: any) => !activeIds.has(e.id)
);

// Compute photos count in the selected date range
const photosInRange = (data.engineers_today ?? []).reduce(
  (acc: number, e: any) => acc + (Number(e.photos) || 0),
  0
);
const isDefaultToday = from === today && to === today;

---

<AdminLayout title="Dashboard">
  <h1>Dashboard</h1>
<div class="toolbar">
  <form method="GET" class="filters">
    <input
      type="date"
      name="from"
      value={from}
      onfocus="this.showPicker()"
    />

    <input
      type="date"
      name="to"
      value={to}
      onfocus="this.showPicker()"
    />

    <button type="submit">
      Apply
    </button>

    <a
      href="/"
      class="btn-reset"
    >
      Reset
    </a>

    <input
      id="dashboard-search"
      type="text"
      class="search-input"
      placeholder="Search engineer by name or code..."
    />

    <button
      id="export-btn"
      type="button"
      class="btn-export"
    >
      Export CSV
    </button>

    <button
      id="export-all-btn"
      type="button"
      class="btn-export-all"
    >
      Export All Time
    </button>
  </form>
</div>
  <div class="stats">
    <div class="stat-card">
      <h3>Total Engineers</h3>
      <p>
        {data.total_engineers}
      </p>
    </div>

    <div class="stat-card">
      <h3>{isDefaultToday ? "Photos Today" : "Photos in Range"}</h3>
      <p>
        {photosInRange}
      </p>
    </div>

    <div class="stat-card">
      <h3>{isDefaultToday ? "Total Photos (All Time)" : "Active Engineers"}</h3>
      <p>
        {isDefaultToday ? data.total_photos : (data.engineers_today ?? []).length}
      </p>
    </div>

    <div class="stat-card">
      <h3>GPS Risk</h3>

      <p
        class={
          data.gps_risk_engineers >
          0
            ? "danger"
            : "success"
        }
      >
        {
          data.gps_risk_engineers
        }
      </p>
    </div>

    <a href={`/offline-engineers?from=${from}&to=${to}`} class="stat-card stat-card-warn stat-card-link">
      <h3>Offline Engineers</h3>
      <p class={offlineEngineers.length > 0 ? "danger" : "success"}>
        {offlineEngineers.length}
      </p>
    </a>
  </div>

<div class="dashboard-grid">
  <div class="section">
    <h2>
      High Risk Engineers
    </h2>

    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Code</th>
          <th>Region</th>
          <th>Subregion</th>
          <th>Risk</th>
          <th>View</th>
        </tr>
      </thead>

      <tbody>
        {(data.high_risk_engineers ?? []).map(
          (
            engineer: any,
          ) => {
            const p = profilesMap.get(engineer.id);
            const region = engineer.region || p?.region || "-";
            const subregion = engineer.subregion || p?.subregion || "-";
            return (
              <tr>
                <td>
                  {engineer.full_name}
                </td>

                <td>
                  {engineer.engineer_code}
                </td>

                <td>
                  {region}
                </td>

                <td>
                  {subregion}
                </td>

                <td>
                  ⚠ High
                </td>

                <td>
                  <a
                    class="btn"
                    href={`/engineers/${engineer.id}`}
                  >
                    View
                  </a>
                </td>
              </tr>
            );
          },
        )}
      </tbody>
    </table>
  </div>
  <div class="section">
  <h2>
    Engineers Active Today
  </h2>

  <table id="today-table">
    <thead>
      <tr>
        <th>Engineer</th>
        <th>Code</th>
        <th>Region</th>
        <th>Subregion</th>
        <th>Photos</th>
        <th>Last Photo</th>
        <th>View</th>
      </tr>
    </thead>

    <tbody>
      {
        data.engineers_today?.map(
          (engineer: any) => {
            const p = profilesMap.get(engineer.id);
            const region = engineer.region || p?.region || "-";
            const subregion = engineer.subregion || p?.subregion || "-";
            return (
              <tr>
                <td>
                  {engineer.full_name}
                </td>

                <td>
                  {engineer.engineer_code}
                </td>

                <td>
                  {region}
                </td>

                <td>
                  {subregion}
                </td>

                <td>
                  {engineer.photos}
                </td>

                <td>
                  {formatEgyptDate(engineer.last_photo)}
                </td>

                <td>
                  <a
                    class="btn"
                    href={`/engineers/${engineer.id}`}
                  >
                    View
                  </a>
                </td>
              </tr>
            );
          },
        )
      }
    </tbody>
  </table>
</div>
</div>
</AdminLayout>

<style>
  .stats {
    display: grid;
    grid-template-columns:
      repeat(
        auto-fit,
        minmax(
          220px,
          1fr
