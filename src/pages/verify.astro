---
import AdminLayout from "../layouts/AdminLayout.astro";
import { verifyPhoto } from "../lib/api";

const tag =
  Astro.url.searchParams.get("tag");

let result = null;

if (tag) {
  result = await verifyPhoto(tag);
  if (result?.found && result?.photo?.id) {
    try {
      const TOKEN = "sb_publishable_yI6-VfmXaCmbr7E8GCq6zg_zTUe-rMB";
      const res = await fetch(`https://vwdwpswpvqdfpsrkmgzy.supabase.co/rest/v1/photo_logs_with_engineer?id=eq.${result.photo.id}`, {
        headers: { apikey: TOKEN, Authorization: `Bearer ${TOKEN}` }
      });
      const extra = await res.json();
      if (Array.isArray(extra) && extra[0]) {
        result.photo.ota_version = extra[0].ota_version;
        result.photo.review_status = extra[0].review_status;
        result.photo.reviewed_at = extra[0].reviewed_at;
        result.photo.reviewed_by = extra[0].reviewed_by;
      }
    } catch (e) {
      console.warn("Error fetching extra photo metadata:", e);
    }
  }
}

---

<AdminLayout title="Verify Photo">
  <h1>Verify Photo</h1>

  <form method="GET">
    <input
      name="tag"
      placeholder="FC-BDC243FC"
      value={tag ?? ""}
    />

    <button type="submit">
      Verify
    </button>
  </form>

{
  result?.found && (
    <div class="card">

      <h2>Photo Information</h2>

      <div class="info-grid">

        <div>
          <strong>Engineer</strong>
          <p>{result.photo.full_name}</p>
        </div>

        <div>
          <strong>Engineer Code</strong>
          <p>{result.photo.engineer_code}</p>
        </div>

        <div>
          <strong>Email</strong>
          <p>{result.photo.email ?? "Not Available"}</p>
        </div>

        <div>
          <strong>Phone</strong>
          <p>{result.photo.phone ?? "Not Available"}</p>
        </div>

        <div>
          <strong>Photo Tag</strong>
          <p>{result.photo.photo_tag}</p>
        </div>

        <div>
          <strong>OTA Version</strong>
          <p style="font-family: monospace; font-weight: bold; color: #38bdf8;">{result.photo.ota_version ? `OTA: ${result.photo.ota_version}` : "OTA: Embedded"}</p>
        </div>

        <div>
          <strong>Date</strong>
          <p>
            {
              new Date(
                result.photo.taken_at,
              ).toLocaleString(
                "en-GB",
                {
                  timeZone: "Africa/Cairo",
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                  hour: "2-digit",
                  minute: "2-digit",
                },
              )
            }
          </p>
        </div>

      </div>

      <hr />

      <h2>Location</h2>

      <p>
        <strong>Address</strong><br />
        {result.photo.address ?? "Address unavailable"}
      </p>

      <p>
        <strong>Coordinates</strong><br />
        {result.photo.latitude},
        {result.photo.longitude}
      </p>

    <div class="map-card">
  <iframe
    width="100%"
    height="350"
    loading="lazy"
    style="border:0;border-radius:12px;"
    src={`https://www.google.com/maps?q=${result.photo.latitude},${result.photo.longitude}&z=18&output=embed`}
  >
  </iframe>
</div>
{
  !result.photo.address && (
    <div class="save-address">
      <button
        id="save-address-btn"
        onclick={`saveAddressUi(
          '${result.photo.id}',
          ${result.photo.latitude},
          ${result.photo.longitude}
        )`}
      >
        💾 Get & Save Address
      </button>
    </div>
  )
}
      <hr />

      <h2>Compliance & Flagging Status</h2>
      <div class="verify-review-box">
        <div>
          <strong>Status: </strong>
          <span class={
            result.photo.review_status === "verified" ? "badge-status badge-verified" :
            result.photo.review_status === "flagged" ? "badge-status badge-flagged" :
            result.photo.review_status === "pending_clear" ? "badge-status badge-pending" :
            "badge-status badge-none"
          }>
            {result.photo.review_status === "verified" ? "✔️ Cleared" :
             result.photo.review_status === "flagged" ? "🚩 Flagged" :
             result.photo.review_status === "pending_clear" ? "⏳ Pending Clear" :
             "Unreviewed"}
          </span>
          {result.photo.reviewed_by && <span class="reviewer-tag">({result.photo.reviewed_by})</span>}
        </div>
        <div class="review-btn-group">
          <button type="button" class="btn-review btn-flag-act" onclick={`updateReviewStatusUi('${result.photo.id}', 'flagged')`}>🚩 Flag Photo</button>
        </div>
      </div>
    </div>
  )
}

  {
    tag &&
      !result?.found && (
        <div class="card error">
          ❌ Photo not found
        </div>
      )
  }
</AdminLayout>

<style>
form {
  display: flex;
  gap: 12px;
  margin-bottom: 28px;
}

input {
  flex: 1;
  padding: 12px 14px;
  border: 1px solid #334155;
  border-radius: 8px;
  font-size: 15px;
  background: #1e293b;
  color: #f8fafc;
}

button {
  padding: 12px 22px;
  border: none;
  border-radius: 8px;
  background: #2563eb;
  color: white;
  font-weight: 600;
  cursor: pointer;
}

button:hover {
  background: #1d4ed8;
}

/* ===================== */

.card {
  background: #1e293b;
  border: 1px solid #334155;
  border-radius: 14px;
  padding: 28px;
  color: #f8fafc;
  box-shadow: 0 6px 24px rgba(0,0,0,.25);
}

/* ===================== */

.verified-banner {
  background: rgba(16, 185, 129, 0.15);
  border: 1px solid #10b981;
  color: #34d399;
  padding: 18px;
  border-radius: 10px;
  text-align: center;
  font-size: 24px;
  font-weight: 700;
  margin-bottom: 28px;
}

.invalid-banner {
  background: rgba(239, 68, 68, 0.15);
  border: 1px solid #ef4444;
  color: #f87171;
  padding: 18px;
  border-radius: 10px;
  text-align: center;
  font-size: 24px;
  font-weight: 700;
}

/* ===================== */

.section-title {
  font-size: 22px;
  font-weight: 700;
  margin-bottom: 20px;
  color: #f8fafc;
}

hr {
  margin: 30px 0;
  border: none;
  border-top: 1px solid #334155;
}

/* ===================== */

.info-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
  gap: 20px;
}

.info-card {
  background: #0f172a;
  border: 1px solid #334155;
  border-radius: 10px;
  padding: 16px;
}

.info-card strong {
  display: block;
  margin-bottom: 6px;
  color: #94a3b8;
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: .4px;
}

.info-card p {
  margin: 0;
  font-size: 16px;
  font-weight: 600;
  color: #f8fafc;
  word-break: break-word;
}

/* ===================== */

.address-box {
  background: #0f172a;
  border: 1px solid #334155;
  border-left: 5px solid #3b82f6;
  border-radius: 10px;
  padding: 18px;
  color: #f8fafc;
  margin-bottom: 20px;
}

.address-box strong {
  display: block;
  margin-bottom: 8px;
  color: #94a3b8;
}

.address-box p {
  margin: 0;
  line-height: 1.6;
  color: #f8fafc;
}

/* ===================== */

.map-card {
  margin-top: 20px;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid #334155;
  box-shadow: 0 2px 8px rgba(0,0,0,.15);
}

.map-card iframe {
  display: block;
}

/* ===================== */

.save-address {
  margin-top: 22px;
  display: flex;
  justify-content: center;
}

#save-address-btn {
  background: #16a34a;
  color: white;
  border: none;
  border-radius: 10px;
  padding: 14px 24px;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  transition: .2s;
}

#save-address-btn:hover {
  background: #15803d;
}

#save-address-btn:disabled {
  background: #475569;
  cursor: not-allowed;
}

/* ===================== */

.gps-good {
  color: #34d399;
  font-weight: 700;
}

.gps-bad {
  color: #f87171;
  font-weight: 700;
}

/* ===================== */

.error {
  background: rgba(239, 68, 68, 0.15);
  border: 1px solid #ef4444;
  padding: 20px;
  border-radius: 10px;
  color: #f87171;
  font-weight: 600;
}

/* ===================== */

.verify-review-box {
  background: #0f172a;
  padding: 18px;
  border-radius: 12px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  border: 1px solid #334155;
  color: #f8fafc;
}

.badge-status {
  padding: 4px 10px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 700;
  display: inline-block;
}
.badge-verified { background: #10b981; color: white; }
.badge-flagged { background: #ef4444; color: white; }
.badge-pending { background: #f59e0b; color: white; }
.badge-none { background: #334155; color: #cbd5e1; }

.reviewer-tag {
  font-size: 12px;
  color: #94a3b8;
  margin-left: 8px;
}

.review-btn-group {
  display: flex;
  gap: 8px;
}

.btn-review {
  padding: 10px 18px;
  font-size: 13px;
  font-weight: 600;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: background 0.15s;
}

.btn-flag-act { background: #ef4444; color: white; }
.btn-flag-act:hover { background: #dc2626; }
.btn-clear-act { background: #10b981; color: white; }
.btn-clear-act:hover { background: #059669; }

@media (max-width:768px) {

  form {
    flex-direction: column;
  }

  button {
    width: 100%;
  }

  .card {
    padding: 20px;
  }

  .info-grid {
    grid-template-columns: 1fr;
  }

}
</style>
<script type="module">
  import "../scripts/verify";
</script>